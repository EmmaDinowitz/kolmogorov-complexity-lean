/-!
# The product of an almost decidable basis over the coordinates

For an almost decidable basis `B` of the mixture `∑ᵢ 2^{-(i+1)} μ i`, the product basis
`piBasis B` (the sets `{x | x j ∈ B k}` at the index `pair j k`) is an almost decidable basis of
`Measure.infinitePi μ` in the presentation `Presentation.pi P` (`IsAlmostDecidableBasisIn.pi`).
The itinerary of a sequence in the product basis is the infinite join of the itineraries of its
coordinates (`itinerary_piBasis`), so the itinerary map carries the product measure to
`piJoinMeasure` (`map_infinitePi_itinerary_piBasis`).

## Conventions

The metric on `ℕ → X` is the local instance `PiCountable.metricSpace`. The boundary cover of
`piBasis B` at `pair j k` is the cover of `B k` at a level shifted by `j + 1`, pulled back to
coordinate `j`, since `μ j ≤ 2^{j+1} • mixMeasure μ` (`le_two_pow_smul_mixMeasure`).

A basic ball `ball(s, ρ)` of `Presentation.pi P` is generated by certificates: a list of entries,
one per coordinate `j < N`, each a basic ball `(m, r)` of `X`, a list of members of `B` whose
intersection lies in that ball (listed by the generation relation of `B`), and a rational bound
`v` for the contribution `min (2^{-j}) (dist (x j) (s j))` of the coordinate (either
`2^{-j} ≤ v`, or `dist (ι m) (s j) < v - r`). The certificate is accepted when the bounds plus
the tail `2 · 2^{-N}` stay below `ρ`.

## Main declarations

* `itinerary_piBasis`, `IsAlmostDecidableBasisIn.pi`, `map_infinitePi_itinerary_piBasis`
  (blueprint node `vlm:pi-basis`).

Used by `Metric/Countable/MainResults.lean`.
-/

namespace Kolmogorov.PointToSet

open MeasureTheory
open scoped Computability ENNReal

attribute [local instance] PiCountable.metricSpace

variable {X : Type*} [MetricSpace X] {P : Presentation X} {A : Set ℕ}

omit [MetricSpace X] in
/-- The itinerary of a sequence in the product basis is the infinite join of the itineraries of
its coordinates. Blueprint node `vlm:pi-basis`. -/
theorem itinerary_piBasis (B : ℕ → Set X) (x : ℕ → X) :
    itinerary (piBasis B) x = cantorPiJoin fun j => itinerary B (x j) := by
  funext n
  unfold itinerary piBasis cantorPiJoin
  exact decide_eq_decide.2 Iff.rfl

/-! ### Coordinates of ideal points and the coordinate projections -/

/-- The ideal index of coordinate `j` of the ideal point of index `n` of `Presentation.pi P`. -/
private def piIdx (n j : ℕ) : ℕ := ((Encodable.decode (α := List ℕ) n).getD []).getD j 0

private lemma primrec_piIdx : Primrec₂ piIdx :=
  (Primrec.list_getD 0).comp
    (Primrec.option_getD.comp (Primrec.decode.comp Primrec.fst) (Primrec.const []))
    Primrec.snd

private lemma pi_ι_apply (n j : ℕ) : P.pi.ι n j = P.ι (piIdx n j) := rfl

/-- The coordinate projections are represented from `Presentation.pi P`, uniformly in the
coordinate: a ball of radius `< 2^{-j}` controls coordinate `j`. -/
private lemma isRepresentedFamilyIn_eval (hP : ComputablePresentationIn P A) :
    IsRepresentedFamilyIn P.pi P A fun (j : ℕ) (x : ℕ → X) ↦ x j := by
  have hlt := birkhoff_computableIn_lt A _ hP
  refine ⟨fun w : ℕ × (ℕ × ℚ) × (ℕ × ℚ) ↦ (0 : ℚ) < w.2.1.2 ∧ w.2.1.2 < (2 : ℚ)⁻¹ ^ w.1 ∧
    dist (P.ι (piIdx w.2.1.1 w.1)) (P.ι w.2.2.1) < ((w.2.2.2 - w.2.1.2 : ℚ) : ℝ), ?_, ?_, ?_⟩
  · have h1 : IsREIn A fun w : ℕ × (ℕ × ℚ) × (ℕ × ℚ) ↦ (0 : ℚ) < w.2.1.2 :=
      isREIn_of_computable_decide (computable₂_ratLt.comp (Computable.const 0)
        (Computable.snd.comp (Computable.fst.comp Computable.snd)))
    have h2 : IsREIn A fun w : ℕ × (ℕ × ℚ) × (ℕ × ℚ) ↦ w.2.1.2 < (2 : ℚ)⁻¹ ^ w.1 :=
      isREIn_of_computable_decide (computable₂_ratLt.comp
        (Computable.snd.comp (Computable.fst.comp Computable.snd))
        (computable_inv_two_pow.comp Computable.fst))
    have h3 : IsREIn A fun w : ℕ × (ℕ × ℚ) × (ℕ × ℚ) ↦
        dist (P.ι (piIdx w.2.1.1 w.1)) (P.ι w.2.2.1) < ((w.2.2.2 - w.2.1.2 : ℚ) : ℝ) :=
      hlt.comp (((primrec_piIdx.to_comp.comp
        (Computable.fst.comp (Computable.fst.comp Computable.snd)) Computable.fst).pair
        (Computable.fst.comp (Computable.snd.comp Computable.snd))).pair
        (computable₂_ratSub.comp (Computable.snd.comp (Computable.snd.comp Computable.snd))
          (Computable.snd.comp (Computable.fst.comp Computable.snd)))).computableIn
    exact h1.and (h2.and h3)
  · intro j b c hR
    obtain ⟨hb0, hbj, hd⟩ : (0 : ℚ) < b.2 ∧ b.2 < (2 : ℚ)⁻¹ ^ j ∧
        dist (P.ι (piIdx b.1 j)) (P.ι c.1) < ((c.2 - b.2 : ℚ) : ℝ) := hR
    have hd' : dist (P.ι (piIdx b.1 j)) (P.ι c.1) < (c.2 : ℝ) - b.2 := by
      push_cast at hd
      exact hd
    have hb0' : (0 : ℝ) < b.2 := by exact_mod_cast hb0
    have hbj' : (b.2 : ℝ) < (2 : ℝ)⁻¹ ^ j := by
      have := (Rat.cast_lt (K := ℝ)).2 hbj
      push_cast at this
      exact this
    refine ⟨hb0, ?_, ?_⟩
    · have : (0 : ℝ) < c.2 := by
        linarith [dist_nonneg (x := P.ι (piIdx b.1 j)) (y := P.ι c.1)]
      exact_mod_cast this
    · rintro _ ⟨x, hx, rfl⟩
      have hx' : dist x (P.pi.ι b.1) < b.2 := hx
      have hj : dist (x j) (P.pi.ι b.1 j) ≤ dist x (P.pi.ι b.1) :=
        PiCountable.dist_le_dist_pi_of_dist_lt (by simpa using hx'.trans hbj')
      rw [pi_ι_apply] at hj
      change dist (x j) (P.ι c.1) < c.2
      linarith [dist_triangle (x j) (P.ι (piIdx b.1 j)) (P.ι c.1)]
  · intro j x c hc
    have hc' : dist (x j) (P.ι c.1) < c.2 := hc
    obtain ⟨t, ht0, ht⟩ := exists_rat_btwn
      (show (0 : ℝ) < min (((c.2 : ℝ) - dist (x j) (P.ι c.1)) / 2) ((2 : ℝ)⁻¹ ^ j) from
        lt_min (by linarith) (by positivity))
    have ht1 : (t : ℝ) < ((c.2 : ℝ) - dist (x j) (P.ι c.1)) / 2 := ht.trans_le (min_le_left _ _)
    have ht2 : (t : ℝ) < (2 : ℝ)⁻¹ ^ j := ht.trans_le (min_le_right _ _)
    obtain ⟨n, hn⟩ := Metric.denseRange_iff.mp P.pi.dense x t ht0
    have hj : dist (x j) (P.pi.ι n j) ≤ dist x (P.pi.ι n) :=
      PiCountable.dist_le_dist_pi_of_dist_lt (by simpa using hn.trans ht2)
    rw [pi_ι_apply] at hj
    have ht2' : t < (2 : ℚ)⁻¹ ^ j := (Rat.cast_lt (K := ℝ)).1 (by push_cast; exact ht2)
    refine ⟨(n, t), ⟨by exact_mod_cast ht0, ht2', ?_⟩, hn⟩
    change dist (P.ι (piIdx n j)) (P.ι c.1) < ((c.2 - t : ℚ) : ℝ)
    push_cast
    linarith [dist_triangle (P.ι (piIdx n j)) (x j) (P.ι c.1),
      dist_comm (P.ι (piIdx n j)) (x j)]

/-- The sets `{x | x j ∈ U i}` for a c.e. open family `U` are c.e. open in `Presentation.pi P`,
uniformly in `(j, i)`. -/
private lemma isCeOpenFamilyIn_coord (hP : ComputablePresentationIn P A) {κ : Type*}
    [Primcodable κ] {U : κ → Set X} (hU : IsCeOpenFamilyIn P A U) :
    IsCeOpenFamilyIn P.pi A fun d : ℕ × κ ↦ {x : ℕ → X | x d.1 ∈ U d.2} :=
  IsRepresentedFamilyIn.preimage_ceOpen (isRepresentedFamilyIn_eval hP) hU

/-- The product of a c.e. open family over the coordinates is c.e. open, uniformly. -/
private lemma isCeOpenFamilyIn_piBasis (hP : ComputablePresentationIn P A) {U : ℕ → Set X}
    (hU : IsCeOpenFamilyIn P A U) : IsCeOpenFamilyIn P.pi A (piBasis U) :=
  IsCeOpenFamilyIn.comp (isCeOpenFamilyIn_coord hP hU) (g := Nat.unpair) Primrec.unpair.to_comp

/-! ### Certificates for the generation of basic balls -/

/-- An entry of a certificate: a basic ball `(m, r)` of `X`, a list of members of the basis, and
a rational bound for the contribution of the coordinate. -/
private abbrev Entry := ((ℕ × ℚ) × List ℕ) × ℚ

/-- The entry at position `j`, with a default past the end. -/
private def entD (c : List Entry) (j : ℕ) : Entry := c.getD j (((0, 0), []), 0)

/-- The sum of the bounds of a certificate. -/
private def certSum (c : List Entry) : ℚ := ∑ j ∈ Finset.range c.length, (entD c j).2

/-- The indices `pair j k` of the members of the product basis named by a certificate. -/
private def certList (c : List Entry) : List ℕ :=
  (List.range c.length).flatMap fun j ↦ (entD c j).1.2.map (Nat.pair j)

/-- An entry is good for coordinate `j` of the ideal point of index `n`: its members generate
inside its ball, and its bound dominates the contribution of the coordinate. -/
private def GoodEntry (P : Presentation X) (EB : (ℕ × ℚ) × List ℕ → Prop) (n j : ℕ)
    (e : Entry) : Prop :=
  EB e.1 ∧ ((2 : ℚ)⁻¹ ^ j ≤ e.2 ∨
    dist (P.ι e.1.1.1) (P.ι (piIdx n j)) < ((e.2 - e.1.1.2 : ℚ) : ℝ))

private lemma primrec_entD : Primrec₂ entD := Primrec.list_getD _

private lemma computable_certSum : Computable certSum := by
  have h : Computable fun c : List Entry ↦
      Nat.rec (motive := fun _ ↦ ℚ) 0 (fun j s ↦ s + (entD c j).2) c.length :=
    Computable.nat_rec Computable.list_length (Computable.const 0)
      (computable₂_ratAdd.comp (Computable.snd.comp Computable.snd)
        (Computable.snd.comp (primrec_entD.to_comp.comp Computable.fst
          (Computable.fst.comp Computable.snd)))).to₂
  refine h.of_eq fun c ↦ ?_
  have key : ∀ N, Nat.rec (motive := fun _ ↦ ℚ) 0 (fun j s ↦ s + (entD c j).2) N =
      ∑ j ∈ Finset.range N, (entD c j).2 := by
    intro N
    induction N with
    | zero => rfl
    | succ N ih => rw [Finset.sum_range_succ, ← ih]
  exact key _

private lemma primrec_certList : Primrec certList :=
  Primrec.list_flatMap (Primrec.list_range.comp Primrec.list_length)
    (Primrec.list_map (Primrec.snd.comp (Primrec.fst.comp primrec_entD))
      (Primrec₂.natPair.comp (Primrec.snd.comp Primrec.fst) Primrec.snd).to₂).to₂

omit [MetricSpace X] in
private lemma mem_biInter_piBasis_certList {B : ℕ → Set X} (c : List Entry) (x : ℕ → X) :
    x ∈ ⋂ k ∈ certList c, piBasis B k ↔ ∀ j < c.length, x j ∈ ⋂ k ∈ (entD c j).1.2, B k := by
  simp only [certList, Set.mem_iInter, List.mem_flatMap, List.mem_range, List.mem_map]
  constructor
  · intro h j hj k hk
    have := h (Nat.pair j k) ⟨j, hj, k, hk, rfl⟩
    simpa [piBasis] using this
  · rintro h _ ⟨j, hj, k, hk, rfl⟩
    simpa [piBasis] using h j hj k hk

/-- The contribution of coordinate `j` to the distance. -/
private lemma dist_pi_eq (x y : ℕ → X) :
    dist x y = ∑' j, min ((2 : ℝ)⁻¹ ^ j) (dist (x j) (y j)) := by
  simp [PiCountable.dist_eq_tsum]

private lemma summable_dist_pi (x y : ℕ → X) :
    Summable fun j ↦ min ((2 : ℝ)⁻¹ ^ j) (dist (x j) (y j)) := by
  simpa using PiCountable.dist_summable x y

/-- Soundness of the certificates: a point whose coordinates lie in the members named by a
good certificate lies in the ball. -/
private lemma dist_lt_of_certificate {B : ℕ → Set X} {EB : (ℕ × ℚ) × List ℕ → Prop}
    (hgen : ∀ b, basicBall P b = ⋃ L ∈ {L | EB (b, L)}, ⋂ k ∈ L, B k) {n : ℕ} {ρ : ℚ}
    {c : List Entry} (hgood : ∀ j (h : j < c.length), GoodEntry P EB n j (c.get ⟨j, h⟩))
    (hsum : certSum c + (2 : ℚ)⁻¹ ^ c.length + (2 : ℚ)⁻¹ ^ c.length < ρ) {x : ℕ → X}
    (hx : ∀ j < c.length, x j ∈ ⋂ k ∈ (entD c j).1.2, B k) :
    dist x (P.pi.ι n) < ρ := by
  set N := c.length
  set f : ℕ → ℝ := fun j ↦ min ((2 : ℝ)⁻¹ ^ j) (dist (x j) (P.pi.ι n j)) with hf
  have hs : Summable f := summable_dist_pi x _
  have hf0 : ∀ j, 0 ≤ f j := fun j ↦ le_min (by positivity) dist_nonneg
  -- the head
  have hhead : ∀ j ∈ Finset.range N, f j ≤ ((entD c j).2 : ℝ) := by
    intro j hj
    have hjN : j < N := Finset.mem_range.mp hj
    have he : entD c j = c.get ⟨j, hjN⟩ := by
      rw [entD, List.getD_eq_getElem _ _ hjN, List.get_eq_getElem]
    obtain ⟨hEB, hcase⟩ := hgood j hjN
    rw [← he] at hEB hcase
    have hxb : x j ∈ basicBall P (entD c j).1.1 := by
      rw [hgen]
      exact Set.mem_iUnion₂.mpr ⟨(entD c j).1.2, hEB, hx j hjN⟩
    have hxb' : dist (x j) (P.ι (entD c j).1.1.1) < (entD c j).1.1.2 := hxb
    rcases hcase with hq | hd
    · have hq' : (2 : ℝ)⁻¹ ^ j ≤ ((entD c j).2 : ℝ) := by
        have := (Rat.cast_le (K := ℝ)).2 hq
        push_cast at this
        exact this
      exact (min_le_left _ _).trans hq'
    · have hd' : dist (P.ι (entD c j).1.1.1) (P.ι (piIdx n j)) <
          ((entD c j).2 : ℝ) - (entD c j).1.1.2 := by
        push_cast at hd
        exact hd
      refine (min_le_right _ _).trans ?_
      rw [pi_ι_apply]
      linarith [dist_triangle (x j) (P.ι (entD c j).1.1.1) (P.ι (piIdx n j))]
  -- the tail
  have htail : ∑' i, f (i + N) ≤ 2 * (2 : ℝ)⁻¹ ^ N := by
    have hg : ∀ i, (2 : ℝ)⁻¹ ^ (i + N) = (2 : ℝ)⁻¹ ^ N * (2 : ℝ)⁻¹ ^ i := fun i ↦ by
      rw [pow_add, mul_comm]
    have hgs : Summable fun i : ℕ ↦ (2 : ℝ)⁻¹ ^ (i + N) := by
      simp_rw [hg]
      exact (summable_geometric_of_lt_one (by norm_num) (by norm_num)).mul_left _
    calc ∑' i, f (i + N) ≤ ∑' i : ℕ, (2 : ℝ)⁻¹ ^ (i + N) :=
          Summable.tsum_le_tsum (fun i ↦ min_le_left _ _) ((summable_nat_add_iff N).2 hs) hgs
      _ = 2 * (2 : ℝ)⁻¹ ^ N := by
          simp_rw [hg]
          rw [tsum_mul_left, tsum_geometric_inv_two, mul_comm]
  have hsum' : ((certSum c : ℚ) : ℝ) + (2 : ℝ)⁻¹ ^ N + (2 : ℝ)⁻¹ ^ N < ρ := by
    have := (Rat.cast_lt (K := ℝ)).2 hsum
    push_cast at this
    exact this
  have hcs : ((certSum c : ℚ) : ℝ) = ∑ j ∈ Finset.range N, ((entD c j).2 : ℝ) := by
    simp [certSum, N]
  rw [dist_pi_eq, ← hs.sum_add_tsum_nat_add N]
  have := Finset.sum_le_sum hhead
  change ∑ i ∈ Finset.range N, f i + ∑' i, f (i + N) < ρ
  linarith

/-- Completeness of the certificates: every point of a ball lies in the members named by some
good certificate. -/
private lemma exists_certificate {B : ℕ → Set X} {EB : (ℕ × ℚ) × List ℕ → Prop}
    (hgen : ∀ b, basicBall P b = ⋃ L ∈ {L | EB (b, L)}, ⋂ k ∈ L, B k) {n : ℕ} {ρ : ℚ}
    {x : ℕ → X} (hx : dist x (P.pi.ι n) < ρ) :
    ∃ c : List Entry, (∀ j (h : j < c.length), GoodEntry P EB n j (c.get ⟨j, h⟩)) ∧
      certSum c + (2 : ℚ)⁻¹ ^ c.length + (2 : ℚ)⁻¹ ^ c.length < ρ ∧
      ∀ j < c.length, x j ∈ ⋂ k ∈ (entD c j).1.2, B k := by
  set γ : ℝ := ρ - dist x (P.pi.ι n) with hγ
  have hγ0 : 0 < γ := by linarith
  obtain ⟨N, hN⟩ := exists_pow_lt_of_lt_one (show 0 < γ / 4 by positivity)
    (show (2 : ℝ)⁻¹ < 1 by norm_num)
  set ε : ℝ := γ / (12 * ((N : ℝ) + 1)) with hεdef
  have hε0 : 0 < ε := by positivity
  have hε : 12 * ((N : ℝ) * ε) + 12 * ε = γ := by
    rw [hεdef]
    field_simp
  have hent : ∀ j, ∃ e : Entry, GoodEntry P EB n j e ∧ x j ∈ ⋂ k ∈ e.1.2, B k ∧
      (e.2 : ℝ) ≤ min ((2 : ℝ)⁻¹ ^ j) (dist (x j) (P.pi.ι n j)) + 3 * ε := by
    intro j
    set d := dist (x j) (P.pi.ι n j) with hd
    rw [pi_ι_apply] at hd
    obtain ⟨r, hr0, hr⟩ := exists_rat_btwn hε0
    obtain ⟨m, hm⟩ := Metric.denseRange_iff.mp P.dense (x j) r hr0
    have hxm : x j ∈ basicBall P (m, r) := hm
    rw [hgen] at hxm
    obtain ⟨L, hL, hxL⟩ := Set.mem_iUnion₂.mp hxm
    obtain ⟨v, hv1, hv2⟩ := exists_rat_btwn (show d + 2 * ε < d + 3 * ε by linarith)
    refine ⟨(((m, r), L), min ((2 : ℚ)⁻¹ ^ j) v), ⟨hL, ?_⟩, hxL, ?_⟩
    · by_cases hqv : (2 : ℚ)⁻¹ ^ j ≤ v
      · exact Or.inl (le_of_eq (min_eq_left hqv).symm)
      · right
        rw [min_eq_right (le_of_not_ge hqv)]
        push_cast
        have := dist_triangle (P.ι m) (x j) (P.ι (piIdx n j))
        rw [dist_comm] at hm
        linarith
    · push_cast
      calc min ((2 : ℝ)⁻¹ ^ j) (v : ℝ) ≤ min ((2 : ℝ)⁻¹ ^ j) (d + 3 * ε) :=
            min_le_min le_rfl hv2.le
        _ ≤ min ((2 : ℝ)⁻¹ ^ j + 3 * ε) (d + 3 * ε) :=
            min_le_min (by linarith) le_rfl
        _ = min ((2 : ℝ)⁻¹ ^ j) d + 3 * ε := min_add_add_right _ _ _
  choose e he using hent
  refine ⟨(List.range N).map e, fun j h ↦ ?_, ?_, fun j h ↦ ?_⟩
  · simpa using (he j).1
  · have hlen : ((List.range N).map e).length = N := by simp
    have hentD : ∀ j ∈ Finset.range N, entD ((List.range N).map e) j = e j := by
      intro j hj
      have hj' : j < ((List.range N).map e).length := by
        rw [hlen]
        exact Finset.mem_range.mp hj
      rw [entD, List.getD_eq_getElem _ _ hj', List.getElem_map, List.getElem_range]
    rw [hlen]
    have hcs : (((certSum ((List.range N).map e)) : ℚ) : ℝ) =
        ∑ j ∈ Finset.range N, ((e j).2 : ℝ) := by
      rw [certSum, hlen, Finset.sum_congr rfl fun j hj ↦ by rw [hentD j hj]]
      push_cast
      rfl
    have hle : ∑ j ∈ Finset.range N, ((e j).2 : ℝ) ≤
        ∑ j ∈ Finset.range N, (min ((2 : ℝ)⁻¹ ^ j) (dist (x j) (P.pi.ι n j)) + 3 * ε) :=
      Finset.sum_le_sum fun j _ ↦ (he j).2.2
    rw [Finset.sum_add_distrib, Finset.sum_const, Finset.card_range, nsmul_eq_mul] at hle
    have hpart : ∑ j ∈ Finset.range N, min ((2 : ℝ)⁻¹ ^ j) (dist (x j) (P.pi.ι n j)) ≤
        dist x (P.pi.ι n) := by
      rw [dist_pi_eq]
      exact (summable_dist_pi x _).sum_le_tsum _ fun j _ ↦ le_min (by positivity) dist_nonneg
    have : ((certSum ((List.range N).map e) + (2 : ℚ)⁻¹ ^ N + (2 : ℚ)⁻¹ ^ N : ℚ) : ℝ) < ρ := by
      push_cast
      linarith
    exact (Rat.cast_lt (K := ℝ)).1 this
  · have hjN : j < N := by simpa using h
    have : entD ((List.range N).map e) j = e j := by
      rw [entD, List.getD_eq_getElem _ _ h, List.getElem_map, List.getElem_range]
    rw [this]
    exact (he j).2.1

/-! ### The product basis -/

variable [MeasurableSpace X] {μ : ℕ → Measure X} {B : ℕ → Set X}

/-- Shifting the level by `c` absorbs a factor `2 ^ c`. -/
private lemma two_pow_mul_le {a : ℝ≥0∞} {n c : ℕ} (ha : a ≤ (2 : ℝ≥0∞)⁻¹ ^ (n + c)) :
    (2 : ℝ≥0∞) ^ c * a ≤ (2 : ℝ≥0∞)⁻¹ ^ n := by
  calc (2 : ℝ≥0∞) ^ c * a ≤ 2 ^ c * (2 : ℝ≥0∞)⁻¹ ^ (n + c) := by gcongr
    _ = (2 : ℝ≥0∞)⁻¹ ^ n := by
      rw [pow_add, mul_comm, mul_assoc, ← mul_pow,
        ENNReal.inv_mul_cancel two_ne_zero ENNReal.ofNat_ne_top, one_pow, mul_one]

/-- The product over the coordinates of an almost decidable basis of the mixture is an almost
decidable basis of the product measure. Blueprint node `vlm:pi-basis`. -/
theorem IsAlmostDecidableBasisIn.pi [∀ i, IsProbabilityMeasure (μ i)]
    (hP : ComputablePresentationIn P A) (hB : IsAlmostDecidableBasisIn P A (mixMeasure μ) B) :
    IsAlmostDecidableBasisIn P.pi A (Measure.infinitePi μ) (piBasis B) := by
  obtain ⟨D, W, hD, hW, hBDW⟩ := hB.exists_exterior
  have hle : ∀ (j : ℕ) (S : Set X),
      Measure.infinitePi μ {x : ℕ → X | x j ∈ S} ≤ 2 ^ (j + 1) * mixMeasure μ S := by
    intro j S
    calc Measure.infinitePi μ {x : ℕ → X | x j ∈ S}
        ≤ (Measure.infinitePi μ).map (fun x : ℕ → X ↦ x j) S :=
          Measure.le_map_apply (μ := Measure.infinitePi μ) (f := fun x : ℕ → X ↦ x j)
            (measurable_pi_apply j).aemeasurable S
      _ = μ j S := by rw [Measure.infinitePi_map_eval]
      _ ≤ 2 ^ (j + 1) * mixMeasure μ S := by
          have := Measure.le_iff'.1 (le_two_pow_smul_mixMeasure μ j) S
          simpa using this
  refine ⟨isCeOpenFamilyIn_piBasis hP hB.isCeOpenFamilyIn,
    ⟨piBasis D, fun w : ℕ × ℕ ↦
      {x : ℕ → X | x (Nat.unpair w.1).1 ∈
        W ((Nat.unpair w.1).2, w.2 + ((Nat.unpair w.1).1 + 1))},
      isCeOpenFamilyIn_piBasis hP hD, ?_, fun k ↦ ?_⟩, ?_⟩
  · have hg : Computable fun w : ℕ × ℕ ↦
        ((Nat.unpair w.1).1, ((Nat.unpair w.1).2, w.2 + ((Nat.unpair w.1).1 + 1))) :=
      ((Primrec.fst.comp (Primrec.unpair.comp Primrec.fst)).pair
        ((Primrec.snd.comp (Primrec.unpair.comp Primrec.fst)).pair
          (Primrec.nat_add.comp Primrec.snd
            (Primrec.succ.comp (Primrec.fst.comp (Primrec.unpair.comp Primrec.fst)))))).to_comp
    exact IsCeOpenFamilyIn.comp (isCeOpenFamilyIn_coord hP hW) hg
  · refine ⟨?_, fun n ↦ ⟨?_, ?_⟩⟩
    · exact Set.disjoint_left.mpr fun x hB' hD' ↦
        Set.disjoint_left.mp (hBDW (Nat.unpair k).2).1 hB' hD'
    · intro x hx
      refine ((hBDW (Nat.unpair k).2).2 (n + ((Nat.unpair k).1 + 1))).1 fun hx' ↦ hx ?_
      rcases hx' with h | h
      · exact Or.inl h
      · exact Or.inr h
    · exact (hle _ _).trans
        (two_pow_mul_le ((hBDW (Nat.unpair k).2).2 (n + ((Nat.unpair k).1 + 1))).2)
  · obtain ⟨EB, hEB, hgen⟩ := hB.generates
    have hlt := birkhoff_computableIn_lt A _ hP
    have hF : IsREIn A fun v : (ℕ × ℚ) × ℕ × Entry ↦ GoodEntry P EB v.1.1 v.2.1 v.2.2 := by
      have h1 : IsREIn A fun v : (ℕ × ℚ) × ℕ × Entry ↦ EB v.2.2.1 :=
        hEB.comp (Computable.fst.comp (Computable.snd.comp Computable.snd)).computableIn
      have h2 : IsREIn A fun v : (ℕ × ℚ) × ℕ × Entry ↦ (2 : ℚ)⁻¹ ^ v.2.1 ≤ v.2.2.2 :=
        isREIn_of_computable_decide ((PrimrecRel.decide ComputableReals.primrec_ratLe).to_comp.comp
          (computable_inv_two_pow.comp (Computable.fst.comp Computable.snd))
          (Computable.snd.comp (Computable.snd.comp Computable.snd)))
      have h3 : IsREIn A fun v : (ℕ × ℚ) × ℕ × Entry ↦
          dist (P.ι v.2.2.1.1.1) (P.ι (piIdx v.1.1 v.2.1)) <
            ((v.2.2.2 - v.2.2.1.1.2 : ℚ) : ℝ) :=
        hlt.comp (((Computable.fst.comp (Computable.fst.comp (Computable.fst.comp
          (Computable.snd.comp Computable.snd)))).pair
          (primrec_piIdx.to_comp.comp (Computable.fst.comp Computable.fst)
            (Computable.fst.comp Computable.snd))).pair
          (computable₂_ratSub.comp (Computable.snd.comp (Computable.snd.comp Computable.snd))
            (Computable.snd.comp (Computable.fst.comp (Computable.fst.comp
              (Computable.snd.comp Computable.snd)))))).computableIn
      exact h1.and (h2.or h3)
    have hgood := (IsREIn.list_forall_get hF).comp
      (f := fun w : ((ℕ × ℚ) × List ℕ) × List Entry ↦ (w.1.1, w.2))
      ((Computable.fst.comp Computable.fst).pair Computable.snd).computableIn
    have hsum : IsREIn A fun w : ((ℕ × ℚ) × List ℕ) × List Entry ↦
        certSum w.2 + (2 : ℚ)⁻¹ ^ w.2.length + (2 : ℚ)⁻¹ ^ w.2.length < w.1.1.2 := by
      have hq : Computable fun w : ((ℕ × ℚ) × List ℕ) × List Entry ↦ (2 : ℚ)⁻¹ ^ w.2.length :=
        computable_inv_two_pow.comp (Computable.list_length.comp Computable.snd)
      exact isREIn_of_computable_decide (computable₂_ratLt.comp
        (computable₂_ratAdd.comp (computable₂_ratAdd.comp
          (computable_certSum.comp Computable.snd) hq) hq)
        (Computable.snd.comp (Computable.fst.comp Computable.fst)))
    have heq : IsREIn A fun w : ((ℕ × ℚ) × List ℕ) × List Entry ↦ w.1.2 = certList w.2 :=
      isREIn_of_computable_decide
        (Primrec.eq.comp (Primrec.snd.comp Primrec.fst)
          (primrec_certList.comp Primrec.snd)).decide.to_comp
    refine ⟨fun w : (ℕ × ℚ) × List ℕ ↦ ∃ c : List Entry,
      (∀ j (h : j < c.length), GoodEntry P EB w.1.1 j (c.get ⟨j, h⟩)) ∧
        certSum c + (2 : ℚ)⁻¹ ^ c.length + (2 : ℚ)⁻¹ ^ c.length < w.1.2 ∧ w.2 = certList c,
      (hgood.and (hsum.and heq)).exists, fun b ↦ ?_⟩
    obtain ⟨n, ρ⟩ := b
    ext x
    simp only [Set.mem_iUnion, Set.mem_ofPred_eq, exists_prop]
    constructor
    · intro hx
      obtain ⟨c, hc, hcs, hxc⟩ := exists_certificate hgen (n := n) (ρ := ρ) hx
      exact ⟨certList c, ⟨c, hc, hcs, rfl⟩, (mem_biInter_piBasis_certList c x).2 hxc⟩
    · rintro ⟨_, ⟨c, hc, hcs, rfl⟩, hxL⟩
      exact dist_lt_of_certificate hgen hc hcs ((mem_biInter_piBasis_certList c x).1 hxL)

