/-- The itinerary map of the product basis carries the product measure to the countable product
of the image measures. Blueprint node `vlm:pi-basis`. -/
theorem map_infinitePi_itinerary_piBasis [∀ i, IsProbabilityMeasure (μ i)]
    (hB : Measurable (itinerary B)) :
    (Measure.infinitePi μ).map (itinerary (piBasis B)) =
      piJoinMeasure fun j => (μ j).map (itinerary B) := by
  have hfun : itinerary (piBasis B) =
      cantorPiJoin ∘ fun (x : ℕ → X) (j : ℕ) => itinerary B (x j) :=
    funext fun x => itinerary_piBasis B x
  have hmeas : Measurable fun (x : ℕ → X) (j : ℕ) => itinerary B (x j) :=
    Measurable.of_eval fun j => hB.comp (measurable_pi_apply j)
  rw [hfun, ← Measure.map_map measurable_cantorPiJoin hmeas,
    Measure.infinitePi_map_pi (μ := μ) (f := fun _ => itinerary B) (fun _ => hB)]
  rfl

