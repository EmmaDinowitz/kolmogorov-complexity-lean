import KolmogorovMathlib.PointToSet.Measure.Ergodic.VyuginFrequencies
import Mathlib.Dynamics.Ergodic.EmpiricalMeasure

/-!
# Random points of an invariant measure on a shift are generic (Remark 7.11)

* `exists_isGenericPoint_of_tendsto_frequency`: on `ℕ → α` (`α` finite) with a first-difference
  metric, if every word frequency in `x` converges then `x` is generic for a shift-invariant
  probability measure `ν`. Proof: the space is compact (`vyuginGen_compactSpace`: a continuous
  image of the compact product `ℕ → Fin (Nat.card α)`), word cylinders are clopen
  (`vyuginGen_isClopen_wordCylinder`), and the clopen sets generate the Borel σ-algebra
  (`vyuginGen_measurableSpace_eq_generateFrom`). A cluster point `ν` of the empirical measures
  `empiricalMeasure shiftMap x n` in the compact space of probability measures (`Prokhorov`) is
  reached along an ultrafilter; portmanteau for clopen sets gives `ν[w] = lim freq(w)`, and
  `ν(σ⁻¹ S) = ν(S)` for every clopen `S` because the empirical masses of `σ⁻¹ S` and `S` differ by
  at most `1/(n+1)`; invariance follows by `ext_of_generate_finite`.
* `exists_isGenericPoint_of_mem_randomPoints'`: V'yugin's theorem as stated in Remark 7.11
  (`exists_isGenericPoint_of_mem_randomPoints` in `RemarksShift`), from the previous item and
  `exists_tendsto_frequency_of_mem_randomPoints`.

Blueprint node `erg:vyugin`.
-/

namespace Kolmogorov.PointToSet

open Filter Set MeasureTheory
open scoped Topology ENNReal Computability

variable {α : Type*} [Finite α] [MetricSpace (ℕ → α)] [MeasurableSpace (ℕ → α)]
  [BorelSpace (ℕ → α)] {β : ℝ}

/-! ### Topology and measure structure of the shift -/

omit [Finite α] [MeasurableSpace (ℕ → α)] [BorelSpace (ℕ → α)] in
/-- For a first-difference metric the coordinates are locally constant: `{x | x i ∈ S}` is
open. -/
private theorem vyuginGen_isOpen_setOf_apply_mem (hβ : 0 < β) (hβ₁ : β < 1)
    (hd : ∀ x y : ℕ → α, x ≠ y → dist x y = β ^ PiNat.firstDiff x y) (i : ℕ) (S : Set α) :
    IsOpen {x : ℕ → α | x i ∈ S} := by
  refine Metric.isOpen_iff.2 fun x hx ↦ ⟨β ^ i, pow_pos hβ i, fun y hy ↦ ?_⟩
  rw [Metric.mem_ball, dist_lt_pow_iff_of_firstDiff hβ hβ₁ hd] at hy
  simpa only [mem_ofPred_eq, hy i le_rfl] using hx

omit [Finite α] [MeasurableSpace (ℕ → α)] [BorelSpace (ℕ → α)] in
/-- For a first-difference metric the sets `{x | x i ∈ S}` are clopen. -/
theorem vyuginGen_isClopen_setOf_apply_mem (hβ : 0 < β) (hβ₁ : β < 1)
    (hd : ∀ x y : ℕ → α, x ≠ y → dist x y = β ^ PiNat.firstDiff x y) (i : ℕ) (S : Set α) :
    IsClopen {x : ℕ → α | x i ∈ S} :=
  ⟨isOpen_compl_iff.1 (vyuginGen_isOpen_setOf_apply_mem hβ hβ₁ hd i Sᶜ),
    vyuginGen_isOpen_setOf_apply_mem hβ hβ₁ hd i S⟩

omit [Finite α] [MeasurableSpace (ℕ → α)] [BorelSpace (ℕ → α)] in
/-- For a first-difference metric the word cylinders are clopen. -/
theorem vyuginGen_isClopen_wordCylinder (hβ : 0 < β) (hβ₁ : β < 1)
    (hd : ∀ x y : ℕ → α, x ≠ y → dist x y = β ^ PiNat.firstDiff x y) {k : ℕ} (w : Fin k → α) :
    IsClopen (wordCylinder w) := by
  have h : wordCylinder w = ⋂ i : Fin k, {y : ℕ → α | y i ∈ ({w i} : Set α)} := by
    ext y
    simp [wordCylinder]
  rw [h]
  exact isClopen_iInter_of_finite fun i ↦ vyuginGen_isClopen_setOf_apply_mem hβ hβ₁ hd i _

omit [MeasurableSpace (ℕ → α)] [BorelSpace (ℕ → α)] in
/-- On a finite alphabet, `ℕ → α` with a first-difference metric is compact: it is the
continuous image of the compact product `ℕ → Fin (Nat.card α)`. -/
theorem vyuginGen_compactSpace (hβ : 0 < β) (hβ₁ : β < 1)
    (hd : ∀ x y : ℕ → α, x ≠ y → dist x y = β ^ PiNat.firstDiff x y) :
    CompactSpace (ℕ → α) := by
  let e : α ≃ Fin (Nat.card α) := Finite.equivFin α
  let g : (ℕ → Fin (Nat.card α)) → ℕ → α := fun z i ↦ e.symm (z i)
  have hg : Continuous g := by
    refine continuous_iff_continuousAt.2 fun z ↦ Metric.tendsto_nhds.2 fun ε hε ↦ ?_
    obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hε hβ₁
    have hev : ∀ᶠ z' in 𝓝 z, ∀ i ∈ Finset.range (k + 1), z' i = z i :=
      (Filter.eventually_all_finset _).2 fun i _ ↦
        (continuous_apply i).continuousAt ((isOpen_discrete {z i}).mem_nhds rfl)
    filter_upwards [hev] with z' hz'
    refine lt_of_lt_of_le ?_ hk.le
    rw [dist_lt_pow_iff_of_firstDiff hβ hβ₁ hd]
    intro i hi
    simp only [g, hz' i (Finset.mem_range.2 (Nat.lt_succ_of_le hi))]
  have hs : Function.Surjective g := fun y ↦ ⟨fun i ↦ e (y i), by simp [g]⟩
  refine ⟨?_⟩
  have := isCompact_univ.image hg
  rwa [image_univ, hs.range_eq] at this

/-- For a first-difference metric on a finite alphabet the Borel σ-algebra is generated by the
clopen sets: every open set is a countable union of word cylinders. -/
theorem vyuginGen_measurableSpace_eq_generateFrom (hβ : 0 < β) (hβ₁ : β < 1)
    (hd : ∀ x y : ℕ → α, x ≠ y → dist x y = β ^ PiNat.firstDiff x y) :
    ‹MeasurableSpace (ℕ → α)› = MeasurableSpace.generateFrom {s | IsClopen s} := by
  refine le_antisymm ?_ (MeasurableSpace.generateFrom_le fun s hs ↦ hs.isOpen.measurableSet)
  rw [BorelSpace.measurable_eq (α := ℕ → α), borel]
  refine MeasurableSpace.generateFrom_le fun U hU ↦ ?_
  have hUeq : U = ⋃ p ∈ {p : Σ k, Fin k → α | wordCylinder p.2 ⊆ U}, wordCylinder p.2 := by
    refine Subset.antisymm (fun x hx ↦ ?_) (iUnion₂_subset fun p hp ↦ hp)
    obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.1 hU x hx
    obtain ⟨k, hk⟩ := exists_pow_lt_of_lt_one hε hβ₁
    refine mem_iUnion₂.2 ⟨⟨k + 1, fun i ↦ x i⟩, fun y hy ↦ hball ?_, fun i ↦ rfl⟩
    rw [Metric.mem_ball]
    refine lt_trans ((dist_lt_pow_iff_of_firstDiff hβ hβ₁ hd).2 fun i hi ↦ ?_) hk
    exact hy ⟨i, Nat.lt_succ_of_le hi⟩
  rw [hUeq]
  exact MeasurableSet.biUnion (to_countable _) fun p _ ↦
    MeasurableSpace.measurableSet_generateFrom (vyuginGen_isClopen_wordCylinder hβ hβ₁ hd p.2)

omit [Finite α] [MetricSpace (ℕ → α)] [BorelSpace (ℕ → α)] in
/-- The empirical measure of `n + 1` steps of an orbit, evaluated on a measurable set, is the
visit frequency. -/
private theorem vyuginGen_empiricalMeasure_real (f : (ℕ → α) → ℕ → α) (x : ℕ → α) (n : ℕ)
    {S : Set (ℕ → α)} (hS : MeasurableSet S) :
    (empiricalMeasure f x n).real S =
      (∑ j ∈ Finset.range (n + 1), S.indicator (1 : (ℕ → α) → ℝ) (f^[j] x)) / (n + 1) := by
  simp only [Measure.real, empiricalMeasure, birkhoffAverage, Nat.cast_add, Nat.cast_one,
    birkhoffSum, Measure.smul_apply, Measure.coe_finsetSum, Finset.sum_apply,
    Measure.dirac_apply' _ hS]
  rw [ENNReal.smul_def, smul_eq_mul, ENNReal.toReal_mul, ENNReal.toReal_sum fun j _ ↦ by
    by_cases h : f^[j] x ∈ S <;> simp [h]]
  rw [div_eq_inv_mul]
  congr 1
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  by_cases h : f^[j] x ∈ S <;> simp [h]

omit [Finite α] [MetricSpace (ℕ → α)] [MeasurableSpace (ℕ → α)] [BorelSpace (ℕ → α)] in
/-- The number of visits of the orbit of `x` to a word cylinder is the number of occurrences of
the word in `x`. -/
private theorem vyuginGen_sum_indicator_wordCylinder (x : ℕ → α) (m : ℕ) {k : ℕ} (w : Fin k → α) :
    ∑ j ∈ Finset.range m, (wordCylinder w).indicator (1 : (ℕ → α) → ℝ) (shiftMap^[j] x) =
      (({j | j < m ∧ ∀ i : Fin k, x (j + i) = w i} : Set ℕ).ncard : ℝ) := by
  classical
  have h : ({j | j < m ∧ ∀ i : Fin k, x (j + i) = w i} : Set ℕ) =
      ↑((Finset.range m).filter fun j ↦ ∀ i : Fin k, x (j + i) = w i) := by
    ext j
    simp
  rw [h, Set.ncard_coe_finset, Finset.card_filter]
  push_cast
  refine Finset.sum_congr rfl fun j _ ↦ ?_
  simp [Set.indicator_apply, wordCylinder, iterate_shiftMap, add_comm]

/-! ### Generic points -/

/-- A sequence all of whose word frequencies converge is generic for a shift-invariant
probability measure. Blueprint node `erg:vyugin`. -/
theorem exists_isGenericPoint_of_tendsto_frequency (hβ : 0 < β) (hβ₁ : β < 1)
    (hd : ∀ x y : ℕ → α, x ≠ y → dist x y = β ^ PiNat.firstDiff x y) {x : ℕ → α}
    (hx : ∀ (k : ℕ) (w : Fin k → α), ∃ l : ℝ, Tendsto
      (fun n : ℕ ↦ ((({j | j < n ∧ ∀ i : Fin k, x (j + i) = w i} : Set ℕ).ncard : ℝ) / n))
      atTop (𝓝 l)) :
    ∃ ν : Measure (ℕ → α), IsProbabilityMeasure ν ∧ MeasurePreserving shiftMap ν ν ∧
      IsGenericPoint ν x := by
  have := vyuginGen_compactSpace hβ hβ₁ hd
  have hcont : Continuous (shiftMap : (ℕ → α) → ℕ → α) := continuous_shiftMap hβ hβ₁ hd
  let e : ℕ → ProbabilityMeasure (ℕ → α) := fun n ↦
    (empiricalMeasure shiftMap x n).toProbabilityMeasure
  obtain ⟨ν, -, hν⟩ := isCompact_univ.exists_mapClusterPt (u := e) (f := atTop) (by simp)
  obtain ⟨U, hU, hUν⟩ := mapClusterPt_iff_ultrafilter.1 hν
  have key : ∀ S : Set (ℕ → α), IsClopen S → Tendsto (fun n : ℕ ↦
      (∑ j ∈ Finset.range (n + 1), S.indicator (1 : (ℕ → α) → ℝ) (shiftMap^[j] x)) / (n + 1))
      (U : Filter ℕ) (𝓝 ((ν : Measure (ℕ → α)).real S)) := by
    intro S hS
    have h := NNReal.tendsto_coe.2
      (ProbabilityMeasure.tendsto_measure_of_isClopen_of_tendsto hUν hS)
    exact h.congr fun n ↦ vyuginGen_empiricalMeasure_real shiftMap x n hS.isOpen.measurableSet
  refine ⟨ν, inferInstance, ⟨hcont.measurable, ?_⟩, fun k w ↦ ?_⟩
  · refine ext_of_generate_finite _ (vyuginGen_measurableSpace_eq_generateFrom hβ hβ₁ hd)
      (fun s hs t ht _ ↦ hs.inter ht) (fun S hS ↦ ?_)
      (by simp [Measure.map_apply hcont.measurable MeasurableSet.univ])
    rw [Measure.map_apply hcont.measurable hS.isOpen.measurableSet]
    have hg : ∀ j, (shiftMap ⁻¹' S).indicator (1 : (ℕ → α) → ℝ) (shiftMap^[j] x) =
        S.indicator 1 (shiftMap^[j + 1] x) := fun j ↦ by
      rw [Function.iterate_succ_apply']
      by_cases h : shiftMap (shiftMap^[j] x) ∈ S
      · rw [Set.indicator_of_mem h,
          Set.indicator_of_mem (show shiftMap^[j] x ∈ shiftMap ⁻¹' S from h), Pi.one_apply,
          Pi.one_apply]
      · rw [Set.indicator_of_notMem h,
          Set.indicator_of_notMem (show shiftMap^[j] x ∉ shiftMap ⁻¹' S from h)]
    have hb : ∀ y, 0 ≤ S.indicator (1 : (ℕ → α) → ℝ) y ∧ S.indicator (1 : (ℕ → α) → ℝ) y ≤ 1 :=
      fun y ↦ by by_cases h : y ∈ S <;> simp [h]
    have hdiff : Tendsto (fun n : ℕ ↦
        (∑ j ∈ Finset.range (n + 1),
          (shiftMap ⁻¹' S).indicator (1 : (ℕ → α) → ℝ) (shiftMap^[j] x)) / (n + 1) -
        (∑ j ∈ Finset.range (n + 1), S.indicator (1 : (ℕ → α) → ℝ) (shiftMap^[j] x)) / (n + 1))
        atTop (𝓝 0) := by
      refine squeeze_zero_norm (fun n ↦ ?_) tendsto_one_div_add_atTop_nhds_zero_nat
      rw [← sub_div, ← Finset.sum_sub_distrib]
      simp only [hg]
      rw [Finset.sum_range_sub (fun j ↦ S.indicator (1 : (ℕ → α) → ℝ) (shiftMap^[j] x)),
        Real.norm_eq_abs, abs_div, abs_of_pos (by positivity : (0 : ℝ) < n + 1)]
      gcongr
      obtain ⟨h1, h2⟩ := hb (shiftMap^[n + 1] x)
      obtain ⟨h3, h4⟩ := hb (shiftMap^[0] x)
      rw [abs_sub_le_iff]
      constructor <;> linarith
    have h3 := tendsto_nhds_unique ((key _ (hS.preimage hcont)).sub (key S hS))
      (hdiff.mono_left hU)
    have h4 : (ν : Measure (ℕ → α)).real (shiftMap ⁻¹' S) = (ν : Measure (ℕ → α)).real S := by
      linarith
    exact (ENNReal.toReal_eq_toReal_iff' (measure_ne_top _ _) (measure_ne_top _ _)).1 h4
  · obtain ⟨l, hl⟩ := hx k w
    have h1 : Tendsto (fun n : ℕ ↦ (∑ j ∈ Finset.range (n + 1),
        (wordCylinder w).indicator (1 : (ℕ → α) → ℝ) (shiftMap^[j] x)) / (n + 1))
        (U : Filter ℕ) (𝓝 l) := by
      refine ((hl.comp (tendsto_add_atTop_nat 1)).mono_left hU).congr fun n ↦ ?_
      simp only [Function.comp_apply, vyuginGen_sum_indicator_wordCylinder]
      push_cast
      rfl
    have hlν := tendsto_nhds_unique h1 (key _ (vyuginGen_isClopen_wordCylinder hβ hβ₁ hd w))
    rw [hlν] at hl
    exact hl


/-- V'yugin's theorem (Remark 7.11): every random point of a shift-invariant measure, relative to
an admissible oracle computing the symbols of the ideal points, is generic for some
shift-invariant probability measure. Blueprint node `erg:vyugin`. -/
theorem exists_isGenericPoint_of_mem_randomPoints' [Primcodable α] (hβ : 0 < β) (hβ₁ : β < 1)
    (hd : ∀ x y : ℕ → α, x ≠ y → dist x y = β ^ PiNat.firstDiff x y)
    (P : Presentation (ℕ → α)) (A : Set ℕ)
    (hP : ComputableIn {charOracle A} fun q : ℕ × ℕ ↦ P.ι q.1 q.2)
    (μ : Measure (ℕ → α)) [IsProbabilityMeasure μ] (hμ : MeasurePreserving shiftMap μ μ)
    (hA : IsMeasureAdmissible P shiftMap μ A) {x : ℕ → α} (hx : x ∈ randomPoints P A μ) :
    ∃ ν : Measure (ℕ → α), IsProbabilityMeasure ν ∧ MeasurePreserving shiftMap ν ν ∧
      IsGenericPoint ν x :=
  exists_isGenericPoint_of_tendsto_frequency hβ hβ₁ hd
    (exists_tendsto_frequency_of_mem_randomPoints hβ hβ₁ hd P A hP μ hμ hA hx)

end Kolmogorov.PointToSet
